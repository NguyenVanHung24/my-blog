---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
---

<Layout title={`About | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <section id="about" class="app-prose mb-28 max-w-app prose-img:border-0">

      <!-- English -->
      <div id="about-en">
        <h1 class="text-2xl tracking-wider sm:text-3xl">About</h1>
        <p>Hey, I'm <strong>Hung</strong> — a cloud security engineer based in Vietnam 🇻🇳.</p>
        <p>I built this space to share three things I care about:</p>
        <ul>
          <li><strong>Resources</strong> — curated links, tools, and books that helped me learn and grow</li>
          <li><strong>Tech</strong> — notes and writeups from things I'm building or figuring out</li>
          <li><strong>Stories</strong> — personal reflections on the journey, the failures, and the wins</li>
        </ul>
        <h2>What I do</h2>
        <p>I work in <strong>cloud security</strong> — helping teams build safer infrastructure on AWS and beyond. My day-to-day involves threat modeling, IAM, security automation, and making sure things don't blow up in production.</p>
        <p>I'm currently going deeper on <strong>Kubernetes security</strong>, and modern zero-trust architecture.</p>
        <p>When I'm not in the terminal, I'm reading, drinking coffee, or thinking about problems that have nothing to do with computers.</p>
        <h2>Why this blog</h2>
        <p>I learn best by writing. If something I share saves you an hour or sparks an idea, that's enough reason for me to keep going.</p>
        <p>Feel free to reach out — I'm always happy to talk.</p>
      </div>

      <!-- Vietnamese -->
      <div id="about-vi" style="display:none">
        <h1 class="text-2xl tracking-wider sm:text-3xl">Giới thiệu</h1>
        <p>Chào, mình là <strong>Hùng</strong> — một kỹ sư bảo mật đám mây đến từ Việt Nam 🇻🇳.</p>
        <p>Mình tạo ra không gian này để chia sẻ ba điều mình quan tâm:</p>
        <ul>
          <li><strong>Tài nguyên</strong> — các link, công cụ và sách đã giúp mình học và phát triển</li>
          <li><strong>Kỹ thuật</strong> — ghi chú và bài viết từ những thứ mình đang xây dựng hoặc tìm hiểu</li>
          <li><strong>Câu chuyện</strong> — những suy nghĩ cá nhân về hành trình, những thất bại và thành công</li>
        </ul>
        <h2>Mình làm gì</h2>
        <p>Mình làm về <strong>bảo mật đám mây</strong> — giúp các team xây dựng hạ tầng an toàn hơn trên AWS và các nền tảng khác. Công việc hàng ngày bao gồm threat modeling, IAM, tự động hóa bảo mật và đảm bảo mọi thứ không bị sập trên môi trường production.</p>
        <p>Hiện tại mình đang đi sâu hơn vào <strong>bảo mật Kubernetes</strong> và kiến trúc zero-trust hiện đại.</p>
        <p>Khi không ngồi trước terminal, mình đọc sách, uống cà phê hoặc suy nghĩ về những vấn đề chẳng liên quan gì đến máy tính.</p>
        <h2>Tại sao có blog này</h2>
        <p>Mình học tốt nhất khi viết ra. Nếu điều gì đó mình chia sẻ giúp bạn tiết kiệm một giờ hoặc gợi lên một ý tưởng, đó là lý do đủ để mình tiếp tục.</p>
        <p>Cứ liên hệ với mình nhé — mình luôn sẵn sàng trò chuyện.</p>
      </div>

    </section>
  </main>
  <Footer />
</Layout>

<script>
  function applyAboutLang() {
    const lang = localStorage.getItem("lang") || "en";
    const en = document.getElementById("about-en");
    const vi = document.getElementById("about-vi");
    if (!en || !vi) return;
    en.style.display = lang === "en" ? "" : "none";
    vi.style.display = lang === "vi" ? "" : "none";
  }
  applyAboutLang();
  document.addEventListener("astro:after-swap", applyAboutLang);
</script>
